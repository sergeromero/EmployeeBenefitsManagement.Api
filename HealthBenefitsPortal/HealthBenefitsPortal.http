@rootURL = https://localhost:7129


GET {{rootURL}}/weatherforecast/
Accept: application/json

###
# @name login
POST {{rootURL}}/api/auth/login
Content-Type: application/json
{
  "email": "admin@benefits.local",
  "password": "Admin123!"
}

###
GET {{rootURL}}/api/employees?name=serge
Authorization: Bearer {{login.response.body.$.accessToken}}

###
POST {{rootURL}}/api/employees/
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json
{
  "employeeNumber" : "11111111",
  "firstName" : "Serge",
  "lastName" : "Romero",
  "eMail" : "serge@mydomain.com",
  "hireDate" : "2015-03-25",
  "departmentId" : "1"
}

###
PUT {{rootURL}}/api/employees/1
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json
{
  "employeeNumber" : "22222222",
  "firstName" : "Serge",
  "lastName" : "Romero",
  "eMail" : "serge@mydomain.com",
  "hireDate" : "2015-03-25",
  "departmentId" : 1
}

###
DELETE {{rootURL}}/api/employees/1
Authorization: Bearer {{login.response.body.$.accessToken}}

###
